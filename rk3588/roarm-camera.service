# Run serial playground and USB video in the project environment.
[Unit]
Description=RoArm serial playground and USB camera
After=network.target

[Service]
Type=simple
ExecStart=/opt/roarm-camera/.venv/bin/python /opt/roarm-camera/camera_server.py --data-dir /var/lib/roarm-playground
Restart=on-failure
RestartSec=3
DynamicUser=yes
SupplementaryGroups=video dialout audio
StateDirectory=roarm-playground
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
